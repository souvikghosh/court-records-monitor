# Search Configuration
# Comma-separated list of names/entities to monitor
SEARCH_TERMS=John Doe,Acme Corporation

# Notification Settings
# Email (optional) - uses SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFY_EMAIL=alerts@example.com

# Webhook (optional) - POST JSON to this URL
WEBHOOK_URL=https://your-webhook-endpoint.com/notify

# Discord webhook (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Database
DATABASE_PATH=./data/records.db

# Browser settings
HEADLESS=true
SCREENSHOT_ON_NEW=true
